{
  "name": "skills",
  "version": "1.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "description": "mbround18's collection of Claude Code / Agent Skills (agentskills.io spec)",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "skill:install": "node scripts/install.mjs",
    "install:all": "node scripts/install.mjs --all",
    "launch": "node skills/launch-project/scripts/launch.mjs",
    "pdf-parse": "node skills/pdf-parse/scripts/pdf-parse.mjs",
    "pwa:audit": "node skills/pwa/scripts/audit.mjs",
    "tomorrow": "node skills/tomorrow/scripts/snapshot.mjs",
    "test:governance": "node --test tests/*.test.mjs",
    "test": "pnpm run test:governance && pnpm -r test"
  }
}
